# Flask
FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=change-this-to-a-random-secret-key

# Database (leave DATABASE_URL empty to use SQLite for local dev)
DATABASE_URL=

# MySQL (production)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=aerial_inspection

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=aerial_inspection

# YOLO Model
YOLO_MODEL_PATH=models/weights/yolov8n.pt
CONFIDENCE_THRESHOLD=0.5

# Drone
DRONE_CONNECTION_STRING=serial:///dev/ttyUSB0:57600
DRONE_SIMULATION_MODE=true
